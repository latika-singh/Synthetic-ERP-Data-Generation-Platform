# =============================================================================
# Synthetic-ERP-Data-Generation-Platform — Environment Configuration Template
# =============================================================================
#
# This file contains ALL environment variables consumed by the platform's
# six backend microservices, the React web console, and supporting
# infrastructure components.
#
# USAGE:
#   1. Copy this file to .env:        cp .env.example .env
#   2. Replace placeholder values with real credentials and settings.
#   3. Never commit the .env file to version control.
#
# Follows the 12-factor app methodology — every configurable parameter is
# driven by environment variables. No credentials, URLs, or connection strings
# are hard-coded in source code.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. GENERAL APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Shared across all backend services and the web console.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me


# -----------------------------------------------------------------------------
# 2. FLASK / API GATEWAY
# -----------------------------------------------------------------------------
# Configuration for the API Gateway service (Flask 3.1.x + Gunicorn 21.x).
# The gateway is the single entry point for all REST API traffic.

FLASK_APP=app
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-secret
API_PORT=5000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Rate limiting tiers (requests per minute) backed by Redis
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_ADMIN=1000


# -----------------------------------------------------------------------------
# 3. AUTH0 / JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Auth0 OAuth 2.0 / OpenID Connect settings for identity management.
# JWT RS256 tokens are validated at the API Gateway and propagated to services.

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.synthetic-erp.com
AUTH0_CALLBACK_URL=http://localhost:3000/callback
JWT_SECRET_KEY=your-jwt-secret
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400


# -----------------------------------------------------------------------------
# 4. MONGODB — METADATA REPOSITORY
# -----------------------------------------------------------------------------
# MongoDB 7.0 stores all platform metadata across five core collections:
#   generation_profiles, statistical_profiles, schema_definitions,
#   audit_logs, tenant_configurations.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=synthetic_erp
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change-me
MONGODB_AUTH_SOURCE=admin
MONGODB_REPLICA_SET=
MONGODB_TLS_ENABLED=false
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10


# -----------------------------------------------------------------------------
# 5. REDIS — CACHING AND SESSION MANAGEMENT
# -----------------------------------------------------------------------------
# Redis 7.x provides API response caching, user session storage,
# rate-limit counters, and real-time job progress tracking via pub/sub.

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_CACHE_TTL=300


# -----------------------------------------------------------------------------
# 6. GENERATION ENGINE SERVICE
# -----------------------------------------------------------------------------
# Multi-method synthetic data generation (AI/ML GAN/VAE, rules-based,
# statistical synthesis, intelligent masking) orchestrated via LangChain.

GENERATION_ENGINE_URL=http://localhost:5001
GENERATION_ENGINE_PORT=5001
BATCH_SIZE=10000
MAX_WORKERS=4
GPU_ENABLED=false
MODEL_PATH=/models
CHECKPOINT_ENABLED=true
CHECKPOINT_INTERVAL=5000
MAX_RECORDS_PER_JOB=10000000
DEFAULT_GENERATION_METHOD=statistical

# LangChain configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=synthetic-erp


# -----------------------------------------------------------------------------
# 7. PROFILING SERVICE
# -----------------------------------------------------------------------------
# ERP schema discovery and statistical profiling using SciPy/NumPy/Pandas.
# Extracts schema metadata WITHOUT accessing raw production data (C-001).

PROFILING_SERVICE_URL=http://localhost:5002
PROFILING_SERVICE_PORT=5002
DISCOVERY_TIMEOUT=300
MAX_TABLES_PER_DISCOVERY=500
PROFILING_SAMPLE_SIZE=10000

# ERP connection settings — metadata-only access
SAP_RFC_HOST=
SAP_RFC_SYSNR=00
SAP_RFC_CLIENT=100
SAP_RFC_USER=
SAP_RFC_PASSWORD=
ORACLE_EBS_HOST=
ORACLE_EBS_PORT=1521
ORACLE_EBS_SERVICE=
DYNAMICS_API_URL=
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 8. QUALITY SERVICE
# -----------------------------------------------------------------------------
# Data quality validation using Great Expectations with a weighted scoring
# model: 40% statistical fidelity, 30% business rules, 30% referential
# integrity. Target threshold: >= 95%.

QUALITY_SERVICE_URL=http://localhost:5003
QUALITY_SERVICE_PORT=5003
QUALITY_THRESHOLD=0.95
STATISTICAL_WEIGHT=0.40
BUSINESS_RULES_WEIGHT=0.30
REFERENTIAL_INTEGRITY_WEIGHT=0.30
QUALITY_REPORT_FORMAT=json


# -----------------------------------------------------------------------------
# 9. COMPLIANCE SERVICE
# -----------------------------------------------------------------------------
# PII detection (spaCy NLP + regex) and regulatory verification
# (GDPR, HIPAA, CCPA). Ensures zero PII leakage in generated datasets.

COMPLIANCE_SERVICE_URL=http://localhost:5004
COMPLIANCE_SERVICE_PORT=5004
SPACY_MODEL=en_core_web_lg
PII_CONFIDENCE_THRESHOLD=0.85
ENABLE_GDPR_CHECK=true
ENABLE_HIPAA_CHECK=true
ENABLE_CCPA_CHECK=true
AUDIT_LOG_RETENTION_YEARS=7


# -----------------------------------------------------------------------------
# 10. PROVISIONING SERVICE
# -----------------------------------------------------------------------------
# Database connectors (PostgreSQL, Oracle, SQL Server, SAP HANA) and cloud
# storage exporters (AWS S3, Azure Blob, GCP Cloud Storage).

PROVISIONING_SERVICE_URL=http://localhost:5005
PROVISIONING_SERVICE_PORT=5005
PROVISIONING_BATCH_INSERT_SIZE=5000
PROVISIONING_CONNECTION_TIMEOUT=30

# Target database JDBC connectors
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/target_db
POSTGRES_JDBC_USER=
POSTGRES_JDBC_PASSWORD=

ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521:ORCL
ORACLE_JDBC_USER=
ORACLE_JDBC_PASSWORD=

SQLSERVER_JDBC_URL=jdbc:sqlserver://localhost:1433;databaseName=target_db
SQLSERVER_JDBC_USER=
SQLSERVER_JDBC_PASSWORD=

HANA_JDBC_URL=jdbc:sap://localhost:30015
HANA_JDBC_USER=
HANA_JDBC_PASSWORD=


# -----------------------------------------------------------------------------
# 11. AWS — CLOUD STORAGE AND SERVICES
# -----------------------------------------------------------------------------
# Amazon Web Services credentials for S3 multi-part upload with AES-256
# server-side encryption.

AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
S3_BUCKET=synthetic-erp-exports
S3_PREFIX=exports/
S3_ENCRYPTION=AES256
S3_ENDPOINT_URL=


# -----------------------------------------------------------------------------
# 12. AZURE — CLOUD STORAGE
# -----------------------------------------------------------------------------
# Azure Blob Storage with managed identity support.

AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=synthetic-erp-exports
AZURE_USE_MANAGED_IDENTITY=false


# -----------------------------------------------------------------------------
# 13. GCP — CLOUD STORAGE
# -----------------------------------------------------------------------------
# Google Cloud Storage with service account authentication.

GCP_PROJECT_ID=your-project
GCP_BUCKET_NAME=synthetic-erp-exports
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GCP_LOCATION=us-central1


# -----------------------------------------------------------------------------
# 14. ENCRYPTION AND SECRETS MANAGEMENT
# -----------------------------------------------------------------------------
# AES-256 encryption at rest, TLS 1.3 in transit. Per-tenant encryption keys
# managed via HashiCorp Vault.

ENCRYPTION_KEY=your-aes-256-key
ENCRYPTION_ALGORITHM=AES-256-GCM
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token
VAULT_MOUNT_PATH=secret
VAULT_NAMESPACE=
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_MIN_VERSION=1.3


# -----------------------------------------------------------------------------
# 15. OBSERVABILITY — TRACING, METRICS, AND LOGGING
# -----------------------------------------------------------------------------
# OpenTelemetry distributed tracing and Prometheus metrics export across
# all services.

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=synthetic-erp-platform
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_URL=http://localhost:3001
LOG_FORMAT=json
STRUCTURED_LOGGING=true


# -----------------------------------------------------------------------------
# 16. MULTI-TENANT CONFIGURATION
# -----------------------------------------------------------------------------
# Namespace isolation, resource quotas, and tenant-specific settings.

DEFAULT_TENANT_ID=default
TENANT_ISOLATION=namespace
TENANT_MAX_CONCURRENT_JOBS=5
TENANT_MAX_STORAGE_GB=100
TENANT_RATE_LIMIT=300


# -----------------------------------------------------------------------------
# 17. FRONTEND — WEB CONSOLE (React 19.x)
# -----------------------------------------------------------------------------
# Vite-based React application environment variables.
# Variables prefixed with VITE_ are exposed to the browser at build time.

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://api.synthetic-erp.com
VITE_AUTH0_CALLBACK_URL=http://localhost:3000/callback
VITE_WS_URL=ws://localhost:5000/ws
VITE_APP_NAME=Synthetic ERP Data Generation Platform
VITE_ENABLE_DEVTOOLS=true


# -----------------------------------------------------------------------------
# 18. CI/CD INTEGRATION
# -----------------------------------------------------------------------------
# Pipeline integration settings for Jenkins, GitLab CI, Azure DevOps,
# and GitHub Actions.

CI=false
CI_REGISTRY=ghcr.io
CI_REGISTRY_IMAGE=synthetic-erp-platform
CI_PIPELINE_WEBHOOK_URL=
JENKINS_URL=
JENKINS_API_TOKEN=
GITLAB_CI_TOKEN=
AZURE_DEVOPS_PAT=


# -----------------------------------------------------------------------------
# 19. DOCKER AND KUBERNETES
# -----------------------------------------------------------------------------
# Container runtime and orchestration configuration.

DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_TAG=latest
K8S_NAMESPACE=synthetic-erp-platform
K8S_CONTEXT=
HELM_RELEASE_NAME=synthetic-erp
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:5000
