*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist
tags

# Emacs
\#*\#
.#*
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.classpath
.project
.settings/

