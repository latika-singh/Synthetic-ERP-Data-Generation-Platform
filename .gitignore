# 11. ML Models and Large Binary Files
# -----------------------------------------------------------------------------
# Trained model files (too large for version control)
*.h5
*.hdf5
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.pb
*.tflite
*.safetensors
*.bin

# Model checkpoints
checkpoints/
model_cache/
models/saved/

# Large datasets (generated synthetic data — use cloud storage instead)
*.parquet
*.feather
data/output/
data/generated/
data/exports/

# Do NOT ignore small reference/seed data or schema definitions
# Those should be committed.

