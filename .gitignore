# -----------------------------------------------------------------------------
# Environment variable files (may contain secrets)
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# Explicitly allow the example template
!.env.example

# Secret and credential files
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
secrets.json
secrets.yaml
secrets.yml
credentials.json

