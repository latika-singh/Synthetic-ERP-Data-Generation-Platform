# =============================================================================
# Synthetic-ERP-Data-Generation-Platform — Monorepo .gitignore
# Covers: Python, Node.js, Terraform, Docker, IDE, Environment, Logs,
#         Build Artifacts, Test Outputs, and ML Model files
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions and shared objects
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.virtualenv/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Linters and formatters
.ruff_cache/
.pylint.d/

# Celery / async task queues
celerybeat-schedule
celerybeat.pid

# Sphinx documentation
docs/_build/

# PyInstaller
*.manifest
*.spec

# Cython debug symbols
cython_debug/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
# poetry.lock  (uncomment if not using poetry for dependency locking)

# PEP 582 – local packages directory
__pypackages__/

# -----------------------------------------------------------------------------
# 2. Node.js
# -----------------------------------------------------------------------------
# Dependencies
node_modules/

# Next.js build output
.next/

# Nuxt.js build output
.nuxt/

# Production build output
out/
dist/

# Cache directories
.cache/
.parcel-cache/

# TypeScript build info
*.tsbuildinfo

# ESLint cache
.eslintcache

# Stylelint cache
.stylelintcache

# Vite
.vite/

# Optional npm cache
.npm/

# Optional eslint cache
.eslintcache

# yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Storybook build
storybook-static/

# -----------------------------------------------------------------------------
# 3. Terraform
# -----------------------------------------------------------------------------
# Local .terraform directory
.terraform/

# State files (contain sensitive information)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.*.backup

# Crash log files
crash.log
crash.*.log

# tfvars files — exclude all EXCEPT example files
# (production, staging, and dev tfvars may contain secrets)
*.tfvars
!*.tfvars.example
!*example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform lock file (generated, provider-specific)
.terraform.lock.hcl

# Terraform plan output
*.tfplan

# -----------------------------------------------------------------------------
# 4. Docker
# -----------------------------------------------------------------------------
# Docker local config
.docker/

# Docker Compose override (local developer customizations)
docker-compose.override.yml

# Docker build context excludes are handled by .dockerignore

# -----------------------------------------------------------------------------
